<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<NoWin32Manifest>true</NoWin32Manifest>
		<Company>theXappy</Company>
		<Description>Examine, create and interact with remote objects in other .NET processes.</Description>
		<Copyright>theXappy ©2021</Copyright>
		<PackageProjectUrl>https://github.com/theXappy/RemoteNET</PackageProjectUrl>
		<PackageIcon>nuget_icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/theXappy/RemoteNET</RepositoryUrl>
		<PackageTags>reverse-engineer;forensics;clrmd;remoting;low-level</PackageTags>
		<PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
		<Version>1.0.4.22</Version>
		<AssemblyVersion>1.0.4.22</AssemblyVersion>
		<FileVersion>1.0.4.22</FileVersion>
		<LangVersion>Latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="InjectableDotNetHost.Injector" Version="1.0.15">
			<IncludeAssets>All</IncludeAssets>
			<PrivateAssets>None</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="System.Management" Version="10.0.2" />
		<PackageReference Include="Vanara.PInvoke.IpHlpApi" Version="4.1.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\SharpDllProxy\SharpDllProxy\SharpDllProxy.csproj" />
		<ProjectReference Include="..\RemoteNET.Common\RemoteNET.Common.csproj" />
		<ProjectReference Include="..\ScubaDiver.API\ScubaDiver.API.csproj" />
		<ProjectReference Include="..\Lifeboat\Lifeboat.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="nuget_icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<PropertyGroup>
		<InjectorBinDir>$(ProjectDir)..\Injector\bin\$(Configuration)</InjectorBinDir>
		<AdapterBinDir>$(ProjectDir)..\UnmanagedAdapterDLL\bin\$(Configuration)</AdapterBinDir>
	</PropertyGroup>
	
	<Target Name="CopyInjector" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<CopyOperationsWin32 Include="$(InjectorBinDir)\Win32\**\*.exe;$(InjectorBinDir)\Win32\**\*.dll;$(InjectorBinDir)\Win32\**\*.pdb">
				<DestinationFolder>$(ProjectDir)\Resources\%(RecursiveDir)</DestinationFolder>
			</CopyOperationsWin32>
			<CopyOperationsX64 Include="$(InjectorBinDir)\x64\**\*.exe;$(InjectorBinDir)\x64\**\*.dll;$(InjectorBinDir)\x64\**\*.pdb">
				<DestinationFolder>$(ProjectDir)\Resources\%(RecursiveDir)</DestinationFolder>
			</CopyOperationsX64>
		</ItemGroup>
		<Message Text="[~] === Copying Injector (Win32) ===" Importance="high" />
		<Message Text="[~] Injector Win32 Files List: @(CopyOperationsWin32)" Importance="high" />
		<Error Condition=" '@(CopyOperationsWin32)' == '' " Text="[!] No Win32 resource files found to copy. Pattern: $(ProjectDir)..\Injector\bin\$(Configuration)\Win32\**\*.exe"/>
		<Copy SourceFiles="@(CopyOperationsWin32)" DestinationFolder="%(CopyOperationsWin32.DestinationFolder)" />
		<Message Text="[~] === Copying Injector (x64) ===" Importance="high" />
		<Message Text="[~] Injector x64 Files List: @(CopyOperationsX64)" Importance="high" />
		<Error Condition=" '@(CopyOperationsX64)' == '' " Text="[!] No x64 resource files found to copy. Pattern: $(ProjectDir)..\Injector\bin\$(Configuration)\x64\**\*.exe"/>
		<Copy SourceFiles="@(CopyOperationsX64)" DestinationFolder="%(CopyOperationsX64.DestinationFolder)" />
	</Target>

	<Target Name="CopyAdapterWin32" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<CopyOperationsUnmanagedWin32 Include="$(AdapterBinDir)\Win32\**\*.exe;$(AdapterBinDir)\Win32\**\*.dll;$(AdapterBinDir)\Win32\**\*.pdb">
				<DestinationFolder>$(ProjectDir)\Resources\%(RecursiveDir)</DestinationFolder>
			</CopyOperationsUnmanagedWin32>
			<CopyOperationsUnmanagedX64 Include="$(AdapterBinDir)\x64\**\*.exe;$(AdapterBinDir)\x64\**\*.dll;$(AdapterBinDir)\x64\**\*.pdb">
				<DestinationFolder>$(ProjectDir)\Resources\%(RecursiveDir)</DestinationFolder>
			</CopyOperationsUnmanagedX64>
		</ItemGroup>
		<Message Text="[~] === Copying UnmanagedAdapterDLL (Win32) ===" Importance="high" />
		<Message Text="[~] UnmanagedAdapterDLL Win32 Files List: @(CopyOperationsUnmanagedWin32)" Importance="high" />
		<Error Condition=" '@(CopyOperationsUnmanagedWin32)' == '' " Text="[!] No UnmanagedAdapterDLL Win32 resource files found to copy. Pattern: $(ProjectDir)..\UnmanagedAdapterDLL\bin\$(Configuration)\Win32\**\*.exe"/>
		<Copy SourceFiles="@(CopyOperationsUnmanagedWin32)" DestinationFolder="%(CopyOperationsUnmanagedWin32.DestinationFolder)" />
		<Message Text="[~] === Copying UnmanagedAdapterDLL (x64) ===" Importance="high" />
		<Message Text="[~] UnmanagedAdapterDLL x64 Files List: @(CopyOperationsUnmanagedX64)" Importance="high" />
		<Error Condition=" '@(CopyOperationsUnmanagedX64)' == '' " Text="[!] No UnmanagedAdapterDLL x64 resource files found to copy. Pattern: $(ProjectDir)..\UnmanagedAdapterDLL\bin\$(Configuration)\x64\**\*.exe"/>
		<Copy SourceFiles="@(CopyOperationsUnmanagedX64)" DestinationFolder="%(CopyOperationsUnmanagedX64.DestinationFolder)" />
	</Target>

	<Target Name="CopyDllsInjectableDummy" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<CopyOperationsDummy Include="$(ProjectDir)\..\InjectableDummy\bin\$(Configuration)\net6.0-windows\**\*">
				<DestinationFolder>$(ProjectDir)\Resources\%(RecursiveDir)</DestinationFolder>
			</CopyOperationsDummy>
		</ItemGroup>
		<Message Text="[~] === Copying InjectableDummy ===" Importance="high" />
		<Message Text="[~] InjectableDummy Resources List: @(CopyOperationsDummy)" Importance="high" />
		<Copy SourceFiles="@(CopyOperationsDummy)" DestinationFolder="%(CopyOperationsDummy.DestinationFolder)" Condition=" '@(CopyOperationsDummy)' != '' " />
	</Target>
	
	<Target Name="ZipFolders" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<ZipOperations Include="$(ProjectDir)\..\Lifeboat\bin\$(Configuration)\net8.0">
				<ZipFileName>$(ProjectDir)\Resources\Lifeboat.zip</ZipFileName>
			</ZipOperations>
			<ZipOperations Include="$(RepoSrcRoot)dist\$(Configuration)\ScubaDivers">
				<ZipFileName>$(ProjectDir)\Resources\ScubaDivers.zip</ZipFileName>
			</ZipOperations>
			<!-- Detours - choose one of 2 directories based on configuration -->
			<ZipOperations Include="$(ProjectDir)\..\detours_build\bin\$(Configuration)" Condition="'$(Configuration)' == 'Debug'">
				<ZipFileName>$(ProjectDir)\Resources\DetoursNet.zip</ZipFileName>
			</ZipOperations>
			<ZipOperations Include="$(ProjectDir)\..\detours_build\bin\RelWithDebInfo" Condition="'$(Configuration)' == 'Release'">
				<ZipFileName>$(ProjectDir)\Resources\DetoursNet.zip</ZipFileName>
			</ZipOperations>
		</ItemGroup>
		<!-- Print MSBuild version for debugging -->
		<Message Text="[~] MSBuild Version: $(MSBuildVersion)" Importance="high" />
		<Message Text="[~] Zip Op (No Compression): @(ZipOperations)" Importance="high" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))" />
		
		<!-- Use CompressionLevel only if MSBuild version supports it (VS 2026+) -->
		<!-- MSBuild 18.0+ supports CompressionLevel parameter -->
		<ZipDirectory SourceDirectory="@(ZipOperations)" DestinationFile="%(ZipOperations.ZipFileName)" Overwrite="true" CompressionLevel="NoCompression" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))" />
		
		<!-- Fallback for older MSBuild versions (VS 2022) without CompressionLevel -->
		<Message Text="[~] Zip Op (Default Compression Algorith): @(ZipOperations)" Importance="high" Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))" />
		<ZipDirectory SourceDirectory="@(ZipOperations)" DestinationFile="%(ZipOperations.ZipFileName)" Overwrite="true" Condition="$([MSBuild]::VersionLessThan('$(MSBuildVersion)', '18.0'))" />
	</Target>



	<ItemGroup>
	  <NativeLibs Remove="RemoteAppFactory.cs" />
	</ItemGroup>

	<ItemGroup>
	  <NativeLibs Remove="ManagedRemoteApp.cs" />
	</ItemGroup>

</Project>
